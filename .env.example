# Copie para .env.local e preencha. O .env.local fica fora do git.
#
# Sem estas duas, o produto guarda tudo num arquivo local em .dados/ e o painel
# fica fechado (modo vitrine). Com as duas, ele fala com o Supabase e o cadastro
# abre. Não existe meio termo de propósito: um painel aberto gravando num
# arquivo único seria a mesma página para todo mundo.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A chave publicável (a antiga anon). É pública por definição: vai dentro do
# JavaScript que qualquer visitante baixa. Quem protege os dados é a RLS.
#
# A chave secreta NÃO entra aqui e não entra em lugar nenhum do projeto: ela
# passa por cima da RLS, e todo erro de política viraria invisível.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereço público, usado no JSON-LD, no canonical e no Open Graph.
# NEXT_PUBLIC_URL_BASE=https://entrais.com.br

# E-mail de suporte. Enquanto fica vazio, a tela de ajuda simplesmente omite o
# bloco de contato, em vez de mostrar um endereço que ninguém responde.
# NEXT_PUBLIC_CONTATO_SUPORTE=

# ---------------------------------------------------------------------------
# Cobrança
# ---------------------------------------------------------------------------
# A chave secreta entra aqui, e só aqui, contrariando a nota lá em cima. O
# motivo é o gatilho protege_cobranca: ele devolve `plano` ao valor anterior
# para todo mundo que não seja o serviço, e essa é a proteção que impede o dono
# de se dar plano pago sozinho. Alguém precisa poder escrever, e esse alguém é
# o webhook de pagamento, que roda no servidor e nunca é iniciado por quem está
# navegando.
#
# A regra da nota continua valendo para o resto: nenhuma tela, nenhum Server
# Action e nenhuma rota que o usuário alcança importa esta chave. Ver o guarda
# no topo de lib/supabase/servico.ts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Credenciais de teste da aplicação no Mercado Pago. Movem dinheiro de mentira,
# e é com elas que os cartões de teste funcionam.
#
# As duas primeiras saem de Suas integrações. A terceira sai de outro lugar, na
# aba Webhooks da mesma aplicação, e aparece uma vez só ao salvar a URL.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Sem ele, qualquer pessoa daria plano pago a si mesma mandando um POST na nossa
# rota de webhook. É o único segredo que separa um aviso de verdade de um aviso
# inventado.
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Quem responde pelos termos e pela política de privacidade
# ---------------------------------------------------------------------------
# Enquanto ficarem vazias, o bloco de identificação some das duas páginas, em
# vez de sair com dado inventado. Preencher antes de cobrar o primeiro real: a
# LGPD pede o controlador identificado, e o Decreto 7.962 pede o fornecedor
# identificado por CNPJ ou CPF. Aceita os dois, e o rótulo sai da contagem de
# dígitos.
NEXT_PUBLIC_RESPONSAVEL=
NEXT_PUBLIC_DOCUMENTO=
