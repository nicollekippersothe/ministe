# Copie para .env.local e preencha. O .env.local fica fora do git.
#
# Sem estas duas, o produto guarda tudo num arquivo local em .dados/ e o painel
# fica fechado (modo vitrine). Com as duas, ele fala com o Supabase e o cadastro
# abre. Não existe meio termo de propósito: um painel aberto gravando num
# arquivo único seria a mesma página para todo mundo.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A chave publicável (a antiga anon). É pública por definição: vai dentro do
# JavaScript que qualquer visitante baixa. Quem protege os dados é a RLS.
#
# A chave secreta NÃO entra aqui e não entra em lugar nenhum do projeto: ela
# passa por cima da RLS, e todo erro de política viraria invisível.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereço público, usado no JSON-LD, no canonical e no Open Graph.
# NEXT_PUBLIC_URL_BASE=https://entrais.com.br

# E-mail de suporte. Enquanto fica vazio, a tela de ajuda simplesmente omite o
# bloco de contato, em vez de mostrar um endereço que ninguém responde.
# NEXT_PUBLIC_CONTATO_SUPORTE=
