# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados locais do painel, enquanto o Supabase nao entra
/.dados/

# sondas de navegador, criadas na raiz e apagadas depois
#
# O pacote playwright só resolve para script que esteja dentro do projeto, então
# toda medição no navegador nasce um arquivo solto aqui na raiz. Ele é
# descartável por definição: existe para rodar uma vez e sair. Ficar fora do git
# evita que uma medição pela metade vire commit.
/medir-*.mjs
/conferir-*.mjs
/*.tmp.mjs
/_*.mjs
